# Copy this file to .env.local and fill in your own values.

# Required: Google Maps JavaScript API key (Maps JavaScript API, Places API,
# and Directions API must be enabled on this key's project).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from the Google Cloud Console (Map Management), only
# needed if you want to apply a custom map style / cloud-based styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: enables short /s/[id] share links (a free Upstash Redis database
# at console.upstash.com; copy the REST URL/token from its dashboard). If
# unset, "Copy share link" still works via a longer self-contained link.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
