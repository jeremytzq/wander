# Copy this file to .env.local and fill in your own values.

# Required: Google Maps JavaScript API key (Maps JavaScript API, Places API,
# and Directions API must be enabled on this key's project).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from the Google Cloud Console (Map Management), only
# needed if you want to apply a custom map style / cloud-based styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: enables short /s/[id] share links, and doubles as the storage
# for signed-in users' account-synced itineraries below. A Postgres
# connection string (Neon, Vercel Postgres, or any Postgres instance both
# work). If unset, "Copy share link" still works via a longer
# self-contained link, and account sync is simply unavailable.
#
# After setting this, create the tables with: npx prisma migrate deploy
DATABASE_URL=

# Optional: only needed if your provider gives you a separate non-pooled
# connection string (Neon and Vercel Postgres both do — DATABASE_URL is
# their pgbouncer-pooled connection, which schema migrations can't run
# over reliably). Used only by the Prisma CLI, not the app itself. Leave
# unset if your provider only gives you one connection string.
DIRECT_URL=

# Optional: enables rate limiting on the API routes (a free Upstash Redis
# database at console.upstash.com; copy the REST URL/token from its
# dashboard). If unset, the routes simply have no rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enables "Sign in" (Google) so itineraries sync across browsers/
# devices instead of staying in one browser's local storage. Needs a Google
# OAuth 2.0 Client ID (console.cloud.google.com/apis/credentials → Create
# credentials → OAuth client ID → Web application). Add both
# "http://localhost:3000/api/auth/callback/google" (for local dev) and
# "https://<your-deployed-domain>/api/auth/callback/google" as Authorized
# redirect URIs on that client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required alongside the two above: a random secret Auth.js uses to sign/
# encrypt session tokens. Generate one with: openssl rand -base64 33
AUTH_SECRET=

# Optional: enables "Generate with AI" (Claude plans the trip, then every
# suggested place is resolved to a real Google Places result). Get a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Required alongside the above: a SEPARATE Google Maps API key from
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, used server-side only. It must NOT have
# an HTTP-referrer restriction (server requests have no browser referrer) —
# instead restrict its "API restrictions" to just "Places API (New)" so it
# can't be used for anything else if it ever leaked. Photos fetched with
# this key are proxied through /api/place-photo, so the key itself is never
# sent to the browser.
GOOGLE_PLACES_SERVER_API_KEY=
